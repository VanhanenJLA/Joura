<div class="brand-shell">
    <div class="brand-mark">J</div>
    <div>
        <a class="navbar-brand" href="">Joura</a>
        <p class="brand-caption">We have Jira at home.</p>
    </div>
</div>

<input type="checkbox" title="Navigation menu" class="navbar-toggler" />

<div class="nav-scrollable">
    <nav class="nav-shell">
        <AuthorizeView>
            <Authorized>
                <div class="nav-main">
                    <div class="nav-group">Navigation</div>
                    <div class="nav-item px-3">
                        <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                            <span class="nav-icon">🏠</span> Home
                        </NavLink>
                    </div>

                    <div class="nav-item px-3">
                        <NavLink class="nav-link" href="board">
                            <span class="nav-icon">🧮</span> Board
                        </NavLink>
                    </div>

                    <div class="nav-item px-3">
                        <NavLink class="nav-link" href="issues">
                            <span class="nav-icon">🗃</span> Issues
                        </NavLink>
                    </div>

                    <div class="nav-item px-3">
                        <NavLink class="nav-link" href="worklogs">
                            <span class="nav-icon">🕒</span> Worklogs
                        </NavLink>
                    </div>

                    <div class="nav-item px-3">
                        <NavLink class="nav-link" href="reports">
                            <span class="nav-icon">🔎</span> Reports
                        </NavLink>
                    </div>
                </div>

                <div class="nav-account">
                    <div class="nav-group">Signed in as</div>
                    <div class="nav-item px-3">
                        <NavLink class="nav-link nav-user-display nav-user-trigger" href="me">
                            <InitialismAvatar Name="@context.User.Identity?.Name" Class="nav-initialism-avatar" />
                            <span>@context.User.Identity?.Name</span>
                        </NavLink>
                    </div>
                </div>
            </Authorized>
            <NotAuthorized>
                <div class="nav-main">
                    <div class="nav-group">Access</div>
                    <div class="nav-item px-3">
                        <NavLink class="nav-link" href="login">
                            <span class="nav-icon">🔑</span> Login
                        </NavLink>
                    </div>
                </div>
            </NotAuthorized>
        </AuthorizeView>
    </nav>
</div>
