@inherits LayoutComponentBase

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <div class="top-row">
            <div class="top-row-spacer" aria-hidden="true"></div>
            <button type="button" class="command-palette-trigger" aria-label="Quick search and command palette" title="Quick search and command palette placeholder">
                <span class="command-palette-icon" aria-hidden="true">/</span>
                <span class="command-palette-copy">Search, jump to issue, or run a command</span>
                <span class="command-palette-shortcut" aria-hidden="true">/</span>
            </button>
            <div class="top-row-actions">
                <a class="action-button" href="/board?createIssue=true">Create issue</a>
            </div>
        </div>

        <article class="content">
            @Body
        </article>
    </main>
</div>

<div id="blazor-error-ui">
    An unhandled error has occurred.
    <a href="" class="reload">Reload</a>
    <a class="dismiss">🗙</a>
</div>
