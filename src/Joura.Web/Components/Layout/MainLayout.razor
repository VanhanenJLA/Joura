@inherits LayoutComponentBase

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <div class="top-row">
            <div class="top-row-spacer" aria-hidden="true"></div>
            <AuthorizeView>
                <Authorized>
                    <CommandPaletteHost/>
                    <div class="top-row-actions">
                        <a class="action-button" href="/board?createIssue=true">Create issue</a>
                    </div>
                </Authorized>
            </AuthorizeView>
        </div>

        <article class="content">
            @Body
        </article>
    </main>
</div>

<div id="blazor-error-ui">
    An unhandled error has occurred.
    <a href="" class="reload">Reload</a>
    <a class="dismiss">🗙</a>
</div>
