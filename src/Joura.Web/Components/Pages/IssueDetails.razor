@page "/issues/{IssueId:guid}"
@rendermode InteractiveServer
@inject IWorkTrackingService WorkTrackingService
@inject AuthenticationStateProvider AuthenticationStateProvider

<PageTitle>Issue</PageTitle>

@if (issue is null)
{
    <p class="empty-state">Loading issue...</p>
}
else
{
    <section class="panel-card">
        <div class="panel-header">
            <div>
                <p class="panel-kicker">@issue.Key</p>
                <h1>@issue.Title</h1>
            </div>
            <div class="tag-row">
                @if (isEditing)
                {
                    <button type="button" class="action-button action-button-secondary" @onclick="CancelEdit">Cancel</button>
                    <button type="button" class="action-button" disabled="@isSavingEdit" @onclick="SaveEditAsync">Save</button>
                }
                else
                {
                    <button type="button" class="action-button action-button-secondary" @onclick="BeginEdit">Edit</button>
                }
            </div>
        </div>

        @if (isEditing)
        {
            <div class="subpanel-card">
                <EditForm Model="editForm" OnValidSubmit="SaveEditAsync">
                    <div class="form-grid">
                        <label class="full-width">
                            <span>Title</span>
                            <InputText @bind-Value="editForm.Title" />
                        </label>
                        <label class="full-width">
                            <span>Description</span>
                            <InputTextArea @bind-Value="editForm.Description" />
                        </label>
                        <label>
                            <span>Type</span>
                            <InputSelect @bind-Value="editForm.Type">
                                @foreach (var type in Enum.GetValues<IssueType>())
                                {
                                    <option value="@type">@type</option>
                                }
                            </InputSelect>
                        </label>
                        <label>
                            <span>Priority</span>
                            <InputSelect @bind-Value="editForm.Priority">
                                @foreach (var priority in Enum.GetValues<IssuePriority>())
                                {
                                    <option value="@priority">@priority</option>
                                }
                            </InputSelect>
                        </label>
                        <label>
                            <span>Assignee</span>
                            <InputSelect @bind-Value="editForm.AssigneeId">
                                <option value="">Unassigned</option>
                                @foreach (var user in users)
                                {
                                    <option value="@user.Id">@user.DisplayName</option>
                                }
                            </InputSelect>
                        </label>
                        <label>
                            <span>Due date</span>
                            <InputDate @bind-Value="editForm.DueDate" />
                        </label>
                        <label class="full-width">
                            <span>Labels (comma separated)</span>
                            <InputText @bind-Value="editForm.Labels" />
                        </label>
                    </div>
                    <button type="submit" class="action-button" disabled="@isSavingEdit">Save changes</button>
                </EditForm>
            </div>
        }
        else
        {
            <div class="detail-grid">
                <div class="subpanel-card">
                    <h2>Description</h2>
                    <p class="body-copy">@issue.Description</p>
                    <div class="tag-row">
                        @foreach (var label in issue.Labels)
                        {
                            <span class="colored-pill" style="--pill-color:@label.Color">@label.Name</span>
                        }
                    </div>
                </div>

                <div class="subpanel-card">
                    <h2>Context</h2>
                    <dl class="meta-list">
                        <div><dt>Project</dt><dd>@issue.ProjectName</dd></div>
                        <div><dt>Type</dt><dd>@issue.Type</dd></div>
                        <div><dt>Priority</dt><dd>@issue.Priority</dd></div>
                        <div><dt>Due date</dt><dd>@(issue.DueDate?.ToString("dd MMM yyyy") ?? "None")</dd></div>
                        <div>
                            <dt>Reporter</dt>
                            <dd class="meta-person">
                                <InitialismAvatar Name="@issue.ReporterName" />
                                <span>@issue.ReporterName</span>
                            </dd>
                        </div>
                        <div>
                            <dt>Assignee</dt>
                            <dd class="meta-person">
                                <InitialismAvatar Name="@issue.AssigneeName" />
                                <span>@(issue.AssigneeName ?? "Unassigned")</span>
                            </dd>
                        </div>
                        <div><dt>Status</dt><dd>@issue.StatusName</dd></div>
                    </dl>
                </div>
            </div>
        }
    </section>

    <section class="page-grid">
        <div class="panel-card">
            <div class="panel-header">
                <div>
                    <p class="panel-kicker">Discussion</p>
                    <h2>Comments</h2>
                </div>
            </div>
            <EditForm class="comment-form" Model="commentForm" OnValidSubmit="AddCommentAsync">
                <div class="comment-form-row">
                    <label class="comment-form-field">
                        <span>Comment</span>
                        <InputTextArea class="comment-input"
                                       placeholder="Add a comment..."
                                       rows="1"
                                       oninput="this.style.height='auto'; this.style.height=this.scrollHeight + 'px';"
                                       @bind-Value="commentForm.Body" />
                    </label>
                    <button class="action-button comment-submit-button" type="submit">Submit</button>
                </div>
            </EditForm>

            <div class="timeline">
                @foreach (var comment in issue.Comments)
                {
                    <article class="timeline-item">
                        <div class="comment-item-header">
                            <div class="comment-item-author">
                                <InitialismAvatar Name="@comment.AuthorName" />
                                <strong>@comment.AuthorName</strong>
                            </div>
                            <span class="comment-item-timestamp">@comment.CreatedUtc.ToLocalTime().ToString("dd MMM yyyy HH:mm")</span>
                        </div>
                        <p>@comment.Body</p>
                    </article>
                }
            </div>
        </div>

        <div class="panel-card">
            <div class="panel-header">
                <div>
                    <p class="panel-kicker">Time</p>
                    <h2>Worklog</h2>
                </div>
                <div class="worklog-panel-actions">
                    <span class="selection-summary">Total @FormatDuration(worklogEntries.Sum(x => x.Minutes))</span>
                    <button type="button" class="action-button" @onclick="OpenWorklogModal">Log time</button>
                </div>
            </div>

            <div class="timeline">
                @foreach (var entry in worklogEntries)
                {
                    <article class="timeline-item">
                        <div class="worklog-row">
                            <div class="worklog-meta">
                                <InitialismAvatar Name="@entry.UserName" />
                                <strong>@entry.UserName</strong>
                                <span class="pill worklog-duration-pill"
                                      title="@($"{entry.StartAt:dd MMM yyyy HH:mm} - {entry.EndAt:HH:mm}")">
                                    @FormatDuration(entry.Minutes)
                                </span>
                            </div>
                            <button type="button"
                                    class="action-button action-button-secondary worklog-delete"
                                    @onclick="() => OpenWorklogModal(entry)">
                                Edit
                            </button>
                        </div>
                        @if (!string.IsNullOrWhiteSpace(entry.Note))
                        {
                            <p>@entry.Note</p>
                        }
                    </article>
                }
            </div>
        </div>

        <div class="panel-card">
            <div class="panel-header">
                <div>
                    <p class="panel-kicker">Audit</p>
                    <h2>History</h2>
                </div>
            </div>
            <div class="timeline">
                @foreach (var audit in issue.AuditTrail)
                {
                    <article class="timeline-item">
                        <div class="audit-item-header">
                            <div class="audit-item-meta">
                                <strong>@audit.EventType</strong>
                                <span class="audit-item-actor">by @audit.ActorName</span>
                            </div>
                            <span class="audit-item-timestamp">@audit.CreatedUtc.ToLocalTime().ToString("dd MMM yyyy HH:mm")</span>
                        </div>
                        <p>@audit.Description</p>
                    </article>
                }
            </div>
        </div>
    </section>
}

@if (showWorklogModal)
{
    <div class="modal-backdrop" @onclick="CloseWorklogModal">
        <section class="modal-panel panel-card" @onclick:stopPropagation="true">
            <div class="panel-header">
                <div>
                    <p class="panel-kicker">Time</p>
                    <h2>@(editingWorklogId.HasValue ? "Edit time" : "Log time")</h2>
                </div>
            </div>

            <EditForm Model="worklogForm" OnValidSubmit="SubmitWorklogAsync">
                <div class="form-grid">
                    <label>
                        <span>Start</span>
                        <InputDate @bind-Value="worklogForm.StartAt" Type="InputDateType.DateTimeLocal" />
                    </label>
                    <label>
                        <span>End</span>
                        <InputDate @bind-Value="worklogForm.EndAt" Type="InputDateType.DateTimeLocal" />
                    </label>
                    <label class="full-width">
                        <span>Note</span>
                        <InputText @bind-Value="worklogForm.Note" />
                    </label>
                </div>

                <div class="modal-actions">
                    @if (editingWorklogId.HasValue)
                    {
                        <button type="button"
                                class="action-button action-button-secondary"
                                @onclick="DeleteEditingWorklogAsync"
                                disabled="@isAddingWorklog || isDeletingWorklog">
                            Delete
                        </button>
                    }
                    <button type="submit" class="action-button" disabled="@isAddingWorklog || isDeletingWorklog">
                        @(editingWorklogId.HasValue ? "Save changes" : "Log time")
                    </button>
                    <button type="button" class="action-button action-button-secondary" @onclick="CloseWorklogModal">Cancel</button>
                </div>
            </EditForm>
        </section>
    </div>
}

@code {
    [Parameter] public Guid IssueId { get; set; }

    private IssueDetailDto? issue;
    private readonly CommentForm commentForm = new();
    private readonly WorklogForm worklogForm = new();
    private Guid? currentUserId;
    private List<UserReferenceDto> users = [];
    private List<WorklogEntryDto> worklogEntries = [];
    private readonly EditIssueForm editForm = new();
    private bool isEditing;
    private bool isSavingEdit;
    private bool isAddingWorklog;
    private bool isDeletingWorklog;
    private bool showWorklogModal;
    private Guid? editingWorklogId;

    protected override async Task OnInitializedAsync()
    {
        currentUserId = await ResolveCurrentUserIdAsync();
        users = (await WorkTrackingService.GetUsersAsync()).ToList();
        await ReloadAsync();
    }

    private async Task AddCommentAsync()
    {
        if (issue is null || !currentUserId.HasValue || string.IsNullOrWhiteSpace(commentForm.Body))
        {
            return;
        }

        await WorkTrackingService.AddCommentAsync(new AddCommentCommand(issue.Id, currentUserId.Value, commentForm.Body));
        commentForm.Body = string.Empty;
        await ReloadAsync();
    }

    private async Task ReloadAsync()
    {
        issue = await WorkTrackingService.GetIssueAsync(IssueId);
        worklogEntries = issue is null
            ? []
            : (await WorkTrackingService.GetIssueWorklogAsync(IssueId)).ToList();
        if (issue is null)
        {
            isEditing = false;
        }
    }

    private void BeginEdit()
    {
        if (issue is null)
        {
            return;
        }

        editForm.Title = issue.Title;
        editForm.Description = issue.Description;
        editForm.Type = issue.Type;
        editForm.Priority = issue.Priority;
        editForm.AssigneeId = users.FirstOrDefault(x => x.DisplayName == issue.AssigneeName)?.Id;
        editForm.DueDate = issue.DueDate;
        editForm.Labels = string.Join(", ", issue.Labels.Select(x => x.Name));
        isEditing = true;
    }

    private void CancelEdit()
    {
        isEditing = false;
    }

    private async Task SaveEditAsync()
    {
        if (issue is null || isSavingEdit || string.IsNullOrWhiteSpace(editForm.Title))
        {
            return;
        }

        try
        {
            isSavingEdit = true;
            await WorkTrackingService.UpdateIssueAsync(new UpdateIssueCommand(
                issue.Id,
                editForm.Title,
                editForm.Description ?? string.Empty,
                editForm.Type,
                editForm.Priority,
                editForm.AssigneeId,
                editForm.DueDate,
                SplitLabels(editForm.Labels)));
            isEditing = false;
            await ReloadAsync();
        }
        finally
        {
            isSavingEdit = false;
        }
    }

    private sealed class CommentForm
    {
        public string Body { get; set; } = string.Empty;
    }

    private sealed class WorklogForm
    {
        public DateTime StartAt { get; set; } = DateTime.Today.AddHours(9);
        public DateTime EndAt { get; set; } = DateTime.Today.AddHours(10);
        public string? Note { get; set; }
    }

    private sealed class EditIssueForm
    {
        public string Title { get; set; } = string.Empty;
        public string? Description { get; set; }
        public IssueType Type { get; set; } = IssueType.Task;
        public IssuePriority Priority { get; set; } = IssuePriority.Medium;
        public Guid? AssigneeId { get; set; }
        public DateOnly? DueDate { get; set; }
        public string? Labels { get; set; }
    }

    private async Task<Guid?> ResolveCurrentUserIdAsync()
    {
        var authenticationState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var userIdClaim = authenticationState.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
        return Guid.TryParse(userIdClaim, out var userId) ? userId : null;
    }

    private static IReadOnlyList<string> SplitLabels(string? labels)
    {
        return string.IsNullOrWhiteSpace(labels)
            ? []
            : labels.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
    }

    private void OpenWorklogModal()
    {
        editingWorklogId = null;
        worklogForm.StartAt = DateTime.Today.AddHours(9);
        worklogForm.EndAt = DateTime.Today.AddHours(10);
        worklogForm.Note = string.Empty;
        showWorklogModal = true;
    }

    private void OpenWorklogModal(WorklogEntryDto entry)
    {
        editingWorklogId = entry.Id;
        worklogForm.StartAt = entry.StartAt;
        worklogForm.EndAt = entry.EndAt;
        worklogForm.Note = entry.Note;
        showWorklogModal = true;
    }

    private void CloseWorklogModal()
    {
        showWorklogModal = false;
        editingWorklogId = null;
    }

    private async Task SubmitWorklogAsync()
    {
        if (issue is null || isAddingWorklog || worklogForm.EndAt <= worklogForm.StartAt)
        {
            return;
        }

        try
        {
            isAddingWorklog = true;
            if (editingWorklogId.HasValue)
            {
                await WorkTrackingService.UpdateWorklogAsync(new UpdateWorklogCommand(
                    editingWorklogId.Value,
                    worklogForm.StartAt,
                    worklogForm.EndAt,
                    worklogForm.Note));
            }
            else
            {
                await WorkTrackingService.AddWorklogAsync(new AddWorklogCommand(
                    issue.Id,
                    worklogForm.StartAt,
                    worklogForm.EndAt,
                    worklogForm.Note));
            }

            showWorklogModal = false;
            editingWorklogId = null;
            worklogForm.Note = string.Empty;
            worklogForm.StartAt = DateTime.Today.AddHours(9);
            worklogForm.EndAt = DateTime.Today.AddHours(10);
            await ReloadAsync();
        }
        finally
        {
            isAddingWorklog = false;
        }
    }

    private async Task DeleteEditingWorklogAsync()
    {
        if (!editingWorklogId.HasValue || isAddingWorklog || isDeletingWorklog)
        {
            return;
        }

        try
        {
            isDeletingWorklog = true;
            await WorkTrackingService.DeleteWorklogAsync(editingWorklogId.Value);
            showWorklogModal = false;
            editingWorklogId = null;
            worklogForm.Note = string.Empty;
            worklogForm.StartAt = DateTime.Today.AddHours(9);
            worklogForm.EndAt = DateTime.Today.AddHours(10);
            await ReloadAsync();
        }
        finally
        {
            isDeletingWorklog = false;
        }
    }

    private static string FormatDuration(int minutes)
    {
        var hours = minutes / 60;
        var remainder = minutes % 60;
        return remainder == 0 ? $"{hours}h" : $"{hours}h {remainder}m";
    }
}
