@page "/issues/{IssueId:guid}"
@rendermode InteractiveServer
@inject IWorkTrackingService WorkTrackingService
@inject AuthenticationStateProvider AuthenticationStateProvider

<PageTitle>Issue</PageTitle>

@if (issue is null)
{
    <p class="empty-state">Loading issue...</p>
}
else
{
    <section class="panel-card">
        <div class="panel-header">
            <div>
                <p class="panel-kicker">@issue.Key</p>
                <h1>@issue.Title</h1>
            </div>
            <div class="tag-row">
                <span class="pill">@issue.Type</span>
                <span class="pill">@issue.Priority</span>
                <span class="pill">@issue.StatusName</span>
            </div>
        </div>

        <div class="detail-grid">
            <div class="subpanel-card">
                <h2>Description</h2>
                <p class="body-copy">@issue.Description</p>
                <div class="tag-row">
                    @foreach (var label in issue.Labels)
                    {
                        <span class="colored-pill" style="--pill-color:@label.Color">@label.Name</span>
                    }
                </div>
            </div>

            <div class="subpanel-card">
                <h2>Context</h2>
                <dl class="meta-list">
                    <div><dt>Project</dt><dd>@issue.ProjectName</dd></div>
                    <div><dt>Reporter</dt><dd>@issue.ReporterName</dd></div>
                    <div><dt>Assignee</dt><dd><InitialismAvatar Name="@issue.AssigneeName" /></dd></div>
                    <div><dt>Status</dt><dd>@issue.StatusName</dd></div>
                </dl>
            </div>
        </div>
    </section>

    <section class="page-grid">
        <div class="panel-card">
            <div class="panel-header">
                <div>
                    <p class="panel-kicker">Discussion</p>
                    <h2>Comments</h2>
                </div>
            </div>
            <EditForm class="comment-form" Model="commentForm" OnValidSubmit="AddCommentAsync">
                <div class="form-grid">
                    <label class="full-width">
                        <span>Comment</span>
                        <InputTextArea class="comment-input"
                                       placeholder="Add a comment..."
                                       rows="1"
                                       oninput="this.style.height='auto'; this.style.height=this.scrollHeight + 'px';"
                                       @bind-Value="commentForm.Body" />
                    </label>
                </div>
                <button class="action-button" type="submit">Submit</button>
            </EditForm>

            <div class="timeline">
                @foreach (var comment in issue.Comments)
                {
                    <article class="timeline-item">
                        <strong>@comment.AuthorName</strong>
                        <span>@comment.CreatedUtc.ToLocalTime().ToString("dd MMM yyyy HH:mm")</span>
                        <p>@comment.Body</p>
                    </article>
                }
            </div>
        </div>

        <div class="panel-card">
            <div class="panel-header">
                <div>
                    <p class="panel-kicker">Audit</p>
                    <h2>History</h2>
                </div>
            </div>
            <div class="timeline">
                @foreach (var audit in issue.AuditTrail)
                {
                    <article class="timeline-item">
                        <strong>@audit.EventType</strong>
                        <span>@audit.CreatedUtc.ToLocalTime().ToString("dd MMM yyyy HH:mm")</span>
                        <p>@audit.ActorName: @audit.Description</p>
                    </article>
                }
            </div>
        </div>
    </section>
}

@code {
    [Parameter] public Guid IssueId { get; set; }

    private IssueDetailDto? issue;
    private readonly CommentForm commentForm = new();
    private Guid? currentUserId;

    protected override async Task OnInitializedAsync()
    {
        currentUserId = await ResolveCurrentUserIdAsync();
        await ReloadAsync();
    }

    private async Task AddCommentAsync()
    {
        if (issue is null || !currentUserId.HasValue || string.IsNullOrWhiteSpace(commentForm.Body))
        {
            return;
        }

        await WorkTrackingService.AddCommentAsync(new AddCommentCommand(issue.Id, currentUserId.Value, commentForm.Body));
        commentForm.Body = string.Empty;
        await ReloadAsync();
    }

    private async Task ReloadAsync()
    {
        issue = await WorkTrackingService.GetIssueAsync(IssueId);
    }

    private sealed class CommentForm
    {
        public string Body { get; set; } = string.Empty;
    }

    private async Task<Guid?> ResolveCurrentUserIdAsync()
    {
        var authenticationState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var userIdClaim = authenticationState.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
        return Guid.TryParse(userIdClaim, out var userId) ? userId : null;
    }
}
