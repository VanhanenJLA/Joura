@page "/reports"
@page "/worklogs/search"
@rendermode InteractiveServer
@inject IWorkTrackingService WorkTrackingService

<PageTitle>Reports</PageTitle>

@if (isLoading)
{
    <p class="empty-state">Loading worklogs...</p>
}
else
{
    <section class="panel-card calendar-shell">
        <div class="calendar-header">
            <div>
                <p class="panel-kicker">Worklogs</p>
                <h1>Search</h1>
            </div>
        </div>

        <div class="calendar-filters">
            <label>
                <span>Search</span>
                <InputText @bind-Value="worklogSearchText" @bind-Value:after="HandleSearchChanged" />
            </label>
            <label>
                <span>Project</span>
                <InputSelect @bind-Value="filter.ProjectId" @bind-Value:after="ReloadAsync">
                    <option value="">All</option>
                    @foreach (var project in projects)
                    {
                        <option value="@project.Id">@project.Key</option>
                    }
                </InputSelect>
            </label>
            <label>
                <span>Logger</span>
                <InputSelect @bind-Value="filter.LoggerId" @bind-Value:after="ReloadAsync">
                    <option value="">Anyone</option>
                    @foreach (var user in users)
                    {
                        <option value="@user.Id">@user.DisplayName</option>
                    }
                </InputSelect>
            </label>
            <label>
                <span>Start</span>
                <InputDate @bind-Value="filter.StartAt" @bind-Value:after="ReloadAsync" Type="InputDateType.DateTimeLocal" />
            </label>
            <label>
                <span>End</span>
                <InputDate @bind-Value="filter.EndAt" @bind-Value:after="ReloadAsync" Type="InputDateType.DateTimeLocal" />
            </label>
        </div>
    </section>

    <section class="panel-card">
        <div class="panel-header">
            <div>
                <p class="panel-kicker">Results</p>
                <h2>@VisibleWorklogEntries.Count worklog items</h2>
            </div>
            <div class="issues-results-actions">
                <span class="selection-summary">@selectedWorklogEntryIds.Count selected</span>
            </div>
        </div>

        <div class="issues-grid-scroll">
            <QuickGrid Items="VisibleWorklogEntries.AsQueryable()" Class="issues-grid-table">
                <TemplateColumn>
                    <HeaderTemplate>
                        <input type="checkbox"
                               title="Select all visible worklog entries"
                               checked="@AreAllVisibleSelected"
                               @onchange="ToggleAllVisibleSelection" />
                    </HeaderTemplate>
                    <ChildContent Context="entry">
                        <input type="checkbox"
                               title="Select worklog entry"
                               checked="@selectedWorklogEntryIds.Contains(entry.Id)"
                               @onchange="args => ToggleWorklogSelection(entry.Id, args)" />
                    </ChildContent>
                </TemplateColumn>
                <TemplateColumn Title="Key" SortBy="SortWorklogByIssue">
                    <a class="text-link" href="/issues/@context.IssueId">@context.IssueKey</a>
                </TemplateColumn>
                <TemplateColumn Title="Title" SortBy="SortWorklogByTitle">
                    <span>@context.IssueTitle</span>
                </TemplateColumn>
                <TemplateColumn Title="Logger" SortBy="SortWorklogByUser">
                    <span>@context.UserName</span>
                </TemplateColumn>
                <TemplateColumn Title="Start" SortBy="SortWorklogByStart">
                    <span>@context.StartAt.ToString("dd MMM yyyy HH:mm")</span>
                </TemplateColumn>
                <TemplateColumn Title="End" SortBy="SortWorklogByEnd">
                    <span>@context.EndAt.ToString("dd MMM yyyy HH:mm")</span>
                </TemplateColumn>
                <TemplateColumn Title="Duration" SortBy="SortWorklogByMinutes">
                    <span class="pill">@FormatDuration(context.Minutes)</span>
                </TemplateColumn>
                <TemplateColumn Title="Note" SortBy="SortWorklogByNote">
                    <span>@(string.IsNullOrWhiteSpace(context.Note) ? "-" : context.Note)</span>
                </TemplateColumn>
            </QuickGrid>
        </div>
    </section>
}

@code {
    private static readonly GridSort<WorklogEntryDto> SortWorklogByIssue = GridSort<WorklogEntryDto>.ByAscending(x => x.IssueKey);
    private static readonly GridSort<WorklogEntryDto> SortWorklogByTitle = GridSort<WorklogEntryDto>.ByAscending(x => x.IssueTitle);
    private static readonly GridSort<WorklogEntryDto> SortWorklogByUser = GridSort<WorklogEntryDto>.ByAscending(x => x.UserName);
    private static readonly GridSort<WorklogEntryDto> SortWorklogByStart = GridSort<WorklogEntryDto>.ByAscending(x => x.StartAt);
    private static readonly GridSort<WorklogEntryDto> SortWorklogByEnd = GridSort<WorklogEntryDto>.ByAscending(x => x.EndAt);
    private static readonly GridSort<WorklogEntryDto> SortWorklogByMinutes = GridSort<WorklogEntryDto>.ByAscending(x => x.Minutes);
    private static readonly GridSort<WorklogEntryDto> SortWorklogByNote = GridSort<WorklogEntryDto>.ByAscending(x => x.Note);

    private readonly WorklogFilterState filter = new();
    private List<ProjectReferenceDto> projects = [];
    private List<UserReferenceDto> users = [];
    private List<WorklogEntryDto> worklogEntries = [];
    private readonly HashSet<Guid> selectedWorklogEntryIds = [];
    private string worklogSearchText = string.Empty;
    private bool isLoading = true;

    private List<WorklogEntryDto> VisibleWorklogEntries => worklogEntries
        .Where(entry => string.IsNullOrWhiteSpace(worklogSearchText)
            || entry.IssueKey.Contains(worklogSearchText, StringComparison.OrdinalIgnoreCase)
            || entry.IssueTitle.Contains(worklogSearchText, StringComparison.OrdinalIgnoreCase)
            || entry.UserName.Contains(worklogSearchText, StringComparison.OrdinalIgnoreCase)
            || entry.Note.Contains(worklogSearchText, StringComparison.OrdinalIgnoreCase))
        .ToList();

    private bool AreAllVisibleSelected => VisibleWorklogEntries.Count > 0
        && VisibleWorklogEntries.All(x => selectedWorklogEntryIds.Contains(x.Id));

    protected override async Task OnInitializedAsync()
    {
        try
        {
            projects = (await WorkTrackingService.GetProjectsAsync()).ToList();
            users = (await WorkTrackingService.GetUsersAsync()).ToList();
            await ReloadAsync();
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task ReloadAsync()
    {
        worklogEntries = (await WorkTrackingService.GetWorklogEntriesAsync(
            new WorklogFilter(filter.ProjectId, filter.LoggerId, filter.StartAt, filter.EndAt)))
            .OrderByDescending(x => x.StartAt)
            .ToList();

        SyncSelectedWorklogsToVisible();
    }

    private Task HandleSearchChanged()
    {
        SyncSelectedWorklogsToVisible();
        return Task.CompletedTask;
    }

    private void ToggleAllVisibleSelection(ChangeEventArgs args)
    {
        if (args.Value is bool isChecked && isChecked)
        {
            foreach (var entry in VisibleWorklogEntries)
            {
                selectedWorklogEntryIds.Add(entry.Id);
            }

            return;
        }

        foreach (var entry in VisibleWorklogEntries)
        {
            selectedWorklogEntryIds.Remove(entry.Id);
        }
    }

    private void ToggleWorklogSelection(Guid worklogEntryId, ChangeEventArgs args)
    {
        if (args.Value is bool isChecked && isChecked)
        {
            selectedWorklogEntryIds.Add(worklogEntryId);
            return;
        }

        selectedWorklogEntryIds.Remove(worklogEntryId);
    }

    private void SyncSelectedWorklogsToVisible()
    {
        var visibleWorklogIds = VisibleWorklogEntries.Select(x => x.Id).ToHashSet();
        selectedWorklogEntryIds.RemoveWhere(x => !visibleWorklogIds.Contains(x));
    }

    private sealed class WorklogFilterState
    {
        public Guid? ProjectId { get; set; }
        public Guid? LoggerId { get; set; }
        public DateTime? StartAt { get; set; }
        public DateTime? EndAt { get; set; }
    }

    private static string FormatDuration(int minutes)
    {
        var hours = minutes / 60;
        var remainder = minutes % 60;
        return remainder == 0 ? $"{hours}h" : $"{hours}h {remainder}m";
    }
}
