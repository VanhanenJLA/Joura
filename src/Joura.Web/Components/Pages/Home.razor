@page "/"
@rendermode InteractiveServer
@inject IWorkTrackingService WorkTrackingService
@inject NavigationManager NavigationManager

<PageTitle>Home</PageTitle>

@if (overview is null)
{
    <p class="empty-state">Loading tenant...</p>
}
else
{
    <section class="hero-card">
        <div>
            <p class="hero-kicker">Overview</p>
            <h1>@overview.TenantName</h1>
            <p class="hero-copy">Your tenant at a glance.</p>
        </div>
        <div class="hero-stats">
            <div class="metric-card">
                <span>Open Issues</span>
                <strong>@overview.OpenIssueCount</strong>
            </div>
            <div class="metric-card">
                <span>Done Issues</span>
                <strong>@overview.CompletedIssueCount</strong>
            </div>
            <div class="metric-card">
                <span>Projects</span>
                <strong>@overview.Projects.Count</strong>
            </div>
        </div>
    </section>

    <section class="panel-card">
        <div class="panel-header">
            <div>
                <p class="panel-kicker">Projects</p>
                <h2>Tenant portfolio</h2>
            </div>
            <button class="action-button" type="button" @onclick="OpenCreateProjectModal">Create project</button>
        </div>
        <div class="project-grid">
            @foreach (var project in overview.Projects)
            {
                <a class="project-card" href="/board?projectId=@project.Id">
                    <span class="project-key">@project.Key</span>
                    <strong>@project.Name</strong>
                    <span>@project.IssueCount issues</span>
                    <span>@project.DoneIssueCount done</span>
                </a>
            }
        </div>
    </section>

    <section class="panel-card">
        <div class="panel-header">
            <div>
                <p class="panel-kicker">Recent activity</p>
                <h2>Latest issues</h2>
            </div>
            <a class="text-link" href="/issues">Open issues</a>
        </div>

        <div class="issue-table">
            @foreach (var issue in overview.RecentIssues)
            {
                <a class="issue-row" href="/issues/@issue.Id">
                    <div>
                        <strong>@issue.Key</strong>
                        <p>@issue.Title</p>
                    </div>
                    <span>@issue.StatusName</span>
                    <span><InitialismAvatar Name="@issue.AssigneeName" /></span>
                    <span>@issue.UpdatedUtc.ToLocalTime().ToString("dd MMM HH:mm")</span>
                </a>
            }
        </div>
    </section>
}

@if (showCreateProjectModal)
{
    <div class="modal-backdrop" @onclick="CloseCreateProjectModal">
        <section class="modal-panel panel-card" @onclick:stopPropagation="true">
            <div class="panel-header">
                <div>
                    <p class="panel-kicker">Create</p>
                    <h2>New project</h2>
                </div>
            </div>

            <EditForm Model="projectForm" OnValidSubmit="CreateProjectAsync">
                <div class="form-grid">
                    <label>
                        <span>Name</span>
                        <InputText @bind-Value="projectForm.Name" />
                    </label>
                    <label>
                        <span>Key</span>
                        <InputText @bind-Value="projectForm.Key" />
                    </label>
                    <label class="full-width">
                        <span>Description</span>
                        <InputTextArea @bind-Value="projectForm.Description" />
                    </label>
                </div>

                <div class="modal-actions">
                    <button class="action-button" type="submit" disabled="@isCreatingProject">Create</button>
                    <button class="action-button action-button-secondary" type="button" @onclick="CloseCreateProjectModal">Cancel</button>
                </div>
            </EditForm>
        </section>
    </div>
}

@code {
    [SupplyParameterFromQuery(Name = "createProject")]
    public bool? CreateProjectQuery { get; set; }

    private TenantOverviewDto? overview;
    private bool isCreatingProject;
    private bool showCreateProjectModal;
    private readonly CreateProjectForm projectForm = new();

    protected override async Task OnInitializedAsync()
    {
        await ReloadAsync();
    }

    protected override void OnParametersSet()
    {
        showCreateProjectModal = CreateProjectQuery == true;
    }

    private void OpenCreateProjectModal()
    {
        showCreateProjectModal = true;
    }

    private void CloseCreateProjectModal()
    {
        showCreateProjectModal = false;

        if (CreateProjectQuery == true)
        {
            NavigationManager.NavigateTo("/", replace: true);
        }
    }

    private async Task CreateProjectAsync()
    {
        if (string.IsNullOrWhiteSpace(projectForm.Name) || string.IsNullOrWhiteSpace(projectForm.Key) || isCreatingProject)
        {
            return;
        }

        try
        {
            isCreatingProject = true;
            await WorkTrackingService.CreateProjectAsync(new CreateProjectCommand(projectForm.Name, projectForm.Key, projectForm.Description ?? string.Empty));
            projectForm.Name = string.Empty;
            projectForm.Key = string.Empty;
            projectForm.Description = string.Empty;
            showCreateProjectModal = false;
            await ReloadAsync();

            if (CreateProjectQuery == true)
            {
                NavigationManager.NavigateTo("/", replace: true);
            }
        }
        finally
        {
            isCreatingProject = false;
        }
    }

    private async Task ReloadAsync()
    {
        overview = await WorkTrackingService.GetTenantOverviewAsync();
    }

    private sealed class CreateProjectForm
    {
        public string Name { get; set; } = string.Empty;
        public string Key { get; set; } = string.Empty;
        public string? Description { get; set; }
    }
}
