@page "/issues"
@rendermode InteractiveServer
@inject IWorkTrackingService WorkTrackingService
@inject AuthenticationStateProvider AuthenticationStateProvider

<PageTitle>Issues</PageTitle>

@if (isLoading)
{
    <p class="empty-state">Loading issues...</p>
}
else if (projects.Count == 0)
{
    <section class="panel-card" data-testid="issues-page">
        <p class="empty-state">No projects found for this tenant.</p>
        <a class="text-link" href="/">Go to Home</a>
    </section>
}
else
{
    <section class="panel-card" data-testid="issues-page">
        <div class="panel-header">
            <div>
                <p class="panel-kicker">Issues</p>
                <h1>Search</h1>
            </div>

            <a class="text-link" href="/board">Create issues from Board</a>
        </div>

        <div class="filters-inline">
            <label class="filters-inline-search">
                <span>Search</span>
                <InputText @bind-Value="filter.SearchText" @bind-Value:after="RefreshIssuesAsync" data-testid="issues-search" />
            </label>
            <label>
                <span>Project</span>
                <InputSelect @bind-Value="filter.ProjectId" @bind-Value:after="RefreshIssuesAsync" data-testid="issues-project-filter">
                    <option value="">All</option>
                    @foreach (var project in projects)
                    {
                        <option value="@project.Id">@project.Key</option>
                    }
                </InputSelect>
            </label>
            <label>
                <span>Priority</span>
                <InputSelect @bind-Value="filter.Priority" @bind-Value:after="RefreshIssuesAsync" data-testid="issues-priority-filter">
                    <option value="">All</option>
                    @foreach (var priority in Enum.GetValues<IssuePriority>())
                    {
                        <option value="@priority">@priority</option>
                    }
                </InputSelect>
            </label>
            <label>
                <span>Status</span>
                <InputSelect @bind-Value="filter.Category" @bind-Value:after="RefreshIssuesAsync" data-testid="issues-status-filter">
                    <option value="">All</option>
                    @foreach (var category in Enum.GetValues<IssueStatusCategory>())
                    {
                        <option value="@category">@category</option>
                    }
                </InputSelect>
            </label>
            <label>
                <span>Assignee</span>
                <InputSelect @bind-Value="filter.AssigneeId" @bind-Value:after="RefreshIssuesAsync" data-testid="issues-assignee-filter">
                    <option value="">Anyone</option>
                    @foreach (var user in users)
                    {
                        <option value="@user.Id">@user.DisplayName</option>
                    }
                </InputSelect>
            </label>
        </div>
    </section>

    <section class="panel-card">
        <div class="panel-header">
            <div>
                <p class="panel-kicker">Results</p>
                <h2 data-testid="issues-result-count">@issues.Count issues</h2>
            </div>
            <div class="issues-results-actions">
                <span class="selection-summary" data-testid="issues-selection-count">@selectedIssueIds.Count selected</span>
                <button type="button"
                        class="action-button action-button-secondary"
                        data-testid="issues-bulk-actions"
                        @onclick="OpenBulkActionsModalAsync"
                        disabled="@(selectedIssueIds.Count == 0)">
                    Bulk actions
                </button>
            </div>
        </div>

        <div class="issues-grid-scroll">
            <QuickGrid Items="issues.AsQueryable()" Class="issues-grid-table">
                <TemplateColumn>
                    <HeaderTemplate>
                        <input type="checkbox"
                               title="Select all visible issues"
                               data-testid="issues-select-all"
                               checked="@AreAllVisibleSelected"
                               @onchange="ToggleAllVisibleSelection" />
                    </HeaderTemplate>
                    <ChildContent Context="issue">
                        <input type="checkbox"
                               title="Select issue"
                               data-testid="@($"issue-select-{issue.Key.ToLowerInvariant()}")"
                               checked="@selectedIssueIds.Contains(issue.Id)"
                               @onchange="args => ToggleIssueSelection(issue.Id, args)" />
                    </ChildContent>
                </TemplateColumn>
                <TemplateColumn Title="Key" SortBy="SortByKey">
                    <span class="issue-grid-key">@context.Key</span>
                </TemplateColumn>
                <TemplateColumn Title="Title" SortBy="SortByTitle">
                    <a class="text-link" href="/issues/@context.Id" data-testid="@($"issue-link-{context.Key.ToLowerInvariant()}")">@context.Title</a>
                </TemplateColumn>
                <TemplateColumn Title="Assignee" SortBy="SortByAssignee">
                    <InitialismAvatar Name="@context.AssigneeName" />
                </TemplateColumn>
                <TemplateColumn Title="Reporter" SortBy="SortByReporter">
                    <InitialismAvatar Name="@context.ReporterName" />
                </TemplateColumn>
                <TemplateColumn Title="Priority" SortBy="SortByPriority">
                    <span class="priority-pill @GetPriorityPillClass(context.Priority)">@context.Priority</span>
                </TemplateColumn>
                <TemplateColumn Title="Status" SortBy="SortByStatus">
                    <span class="status-pill @GetStatusPillClass(context.StatusCategory)">@context.StatusName</span>
                </TemplateColumn>
                <TemplateColumn Title="Due date" SortBy="SortByDueDate">
                    <span class="due-pill @GetDuePillClass(context.DueDate)">@GetDueDateText(context.DueDate)</span>
                </TemplateColumn>
                <TemplateColumn Title="Updated" SortBy="SortByUpdated">
                    @context.UpdatedUtc.ToLocalTime().ToString("dd MMM HH:mm")
                </TemplateColumn>
            </QuickGrid>
        </div>
    </section>
}

@if (showBulkActionsModal)
{
    <div class="modal-backdrop" @onclick="CloseBulkActionsModal">
        <section class="modal-panel panel-card" data-testid="bulk-actions-modal" @onclick:stopPropagation="true">
            <div class="panel-header">
                <div>
                    <p class="panel-kicker">Issues</p>
                    <h2>Bulk actions</h2>
                    <p class="body-copy">Apply one change to @selectedIssueIds.Count selected issues.</p>
                </div>
            </div>

            <div class="form-grid">
                <label class="full-width">
                    <span>Action</span>
                    <InputSelect @bind-Value="bulkActionKind" @bind-Value:after="HandleBulkActionKindChangedAsync" data-testid="bulk-action-kind">
                        <option value="@BulkActionKind.AssignAssignee">Change assignee</option>
                        <option value="@BulkActionKind.MoveStatus" disabled="@(!CanBulkChangeStatus)">Move status</option>
                    </InputSelect>
                </label>

                @if (bulkActionKind == BulkActionKind.AssignAssignee)
                {
                    <label class="full-width">
                        <span>Assignee</span>
                        <InputSelect @bind-Value="bulkAssigneeValue" data-testid="bulk-assignee">
                            <option value="">Select assignee</option>
                            <option value="@UnassignedAssigneeValue">Unassigned</option>
                            @foreach (var user in users)
                            {
                                <option value="@user.Id">@user.DisplayName</option>
                            }
                        </InputSelect>
                    </label>
                }
                else
                {
                    <label class="full-width">
                        <span>Status</span>
                        <InputSelect @bind-Value="bulkStatusId" data-testid="bulk-status" disabled="@(!CanBulkChangeStatus)">
                            <option value="">Select status</option>
                            @foreach (var status in bulkStatuses)
                            {
                                <option value="@status.Id">@status.Name</option>
                            }
                        </InputSelect>
                    </label>
                    @if (!CanBulkChangeStatus)
                    {
                        <p class="selection-summary">Status changes require all selected issues to belong to the same project.</p>
                    }
                }
            </div>

            <div class="modal-actions">
                <button type="button"
                        class="action-button"
                        data-testid="bulk-apply"
                        @onclick="ApplyBulkActionAsync"
                        disabled="@(!CanApplyBulkAction || isApplyingBulkAction)">
                    Apply
                </button>
                <button type="button" class="action-button action-button-secondary" data-testid="bulk-cancel" @onclick="CloseBulkActionsModal">Cancel</button>
            </div>
        </section>
    </div>
}

@code {
    private const string UnassignedAssigneeValue = "__unassigned__";

    private static readonly GridSort<IssueSummaryDto> SortByKey = GridSort<IssueSummaryDto>.ByAscending(x => x.Key);
    private static readonly GridSort<IssueSummaryDto> SortByTitle = GridSort<IssueSummaryDto>.ByAscending(x => x.Title);
    private static readonly GridSort<IssueSummaryDto> SortByAssignee = GridSort<IssueSummaryDto>.ByAscending(x => x.AssigneeName ?? string.Empty);
    private static readonly GridSort<IssueSummaryDto> SortByReporter = GridSort<IssueSummaryDto>.ByAscending(x => x.ReporterName);
    private static readonly GridSort<IssueSummaryDto> SortByPriority = GridSort<IssueSummaryDto>.ByAscending(x => x.Priority);
    private static readonly GridSort<IssueSummaryDto> SortByStatus = GridSort<IssueSummaryDto>.ByAscending(x => x.StatusName);
    private static readonly GridSort<IssueSummaryDto> SortByDueDate = GridSort<IssueSummaryDto>.ByAscending(x => x.DueDate ?? DateOnly.MaxValue);
    private static readonly GridSort<IssueSummaryDto> SortByUpdated = GridSort<IssueSummaryDto>.ByAscending(x => x.UpdatedUtc);

    private readonly IssueFilterState filter = new();
    private List<ProjectReferenceDto> projects = [];
    private List<UserReferenceDto> users = [];
    private List<IssueSummaryDto> issues = [];
    private List<StatusReferenceDto> bulkStatuses = [];
    private readonly HashSet<Guid> selectedIssueIds = [];
    private Guid? currentUserId;
    private bool isLoading = true;
    private bool isApplyingBulkAction;
    private bool showBulkActionsModal;
    private BulkActionKind bulkActionKind = BulkActionKind.AssignAssignee;
    private string bulkAssigneeValue = string.Empty;
    private Guid? bulkStatusId;

    private Guid? SelectedProjectId => issues
        .Where(x => selectedIssueIds.Contains(x.Id))
        .Select(x => x.ProjectId)
        .Distinct()
        .Take(2)
        .ToList() is var projectIds && projectIds.Count == 1
            ? projectIds[0]
            : null;

    private bool CanBulkChangeStatus => SelectedProjectId.HasValue;

    private bool CanApplyBulkAction => bulkActionKind switch
    {
        BulkActionKind.AssignAssignee => !string.IsNullOrWhiteSpace(bulkAssigneeValue),
        BulkActionKind.MoveStatus => CanBulkChangeStatus && bulkStatusId.HasValue && currentUserId.HasValue,
        _ => false
    };

    protected override async Task OnInitializedAsync()
    {
        try
        {
            currentUserId = await ResolveCurrentUserIdAsync();
            projects = (await WorkTrackingService.GetProjectsAsync()).ToList();
            users = (await WorkTrackingService.GetUsersAsync()).ToList();

            if (projects.Count > 0)
            {
                await RefreshIssuesAsync();
            }
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task RefreshIssuesAsync()
    {
        issues = (await WorkTrackingService.SearchIssuesAsync(
            new IssueFilter(filter.SearchText, filter.ProjectId, filter.AssigneeId, filter.Category, filter.Priority)))
            .ToList();

        var visibleIssueIds = issues.Select(x => x.Id).ToHashSet();
        selectedIssueIds.RemoveWhere(x => !visibleIssueIds.Contains(x));
    }

    private bool AreAllVisibleSelected => issues.Count > 0 && issues.All(x => selectedIssueIds.Contains(x.Id));

    private void ToggleAllVisibleSelection(ChangeEventArgs args)
    {
        var shouldSelectAll = args.Value is bool value && value;

        if (shouldSelectAll)
        {
            foreach (var issue in issues)
            {
                selectedIssueIds.Add(issue.Id);
            }
            return;
        }

        foreach (var issue in issues)
        {
            selectedIssueIds.Remove(issue.Id);
        }
    }

    private void ToggleIssueSelection(Guid issueId, ChangeEventArgs args)
    {
        var isSelected = args.Value is bool value && value;
        if (isSelected)
        {
            selectedIssueIds.Add(issueId);
        }
        else
        {
            selectedIssueIds.Remove(issueId);
        }
    }

    private async Task OpenBulkActionsModalAsync()
    {
        if (selectedIssueIds.Count == 0)
        {
            return;
        }

        bulkActionKind = CanBulkChangeStatus ? BulkActionKind.MoveStatus : BulkActionKind.AssignAssignee;
        bulkAssigneeValue = string.Empty;
        bulkStatusId = null;
        await HandleBulkActionKindChangedAsync();
        showBulkActionsModal = true;
    }

    private void CloseBulkActionsModal()
    {
        showBulkActionsModal = false;
    }

    private async Task HandleBulkActionKindChangedAsync()
    {
        bulkStatusId = null;
        bulkStatuses = [];

        if (bulkActionKind == BulkActionKind.MoveStatus && SelectedProjectId.HasValue)
        {
            bulkStatuses = (await WorkTrackingService.GetStatusesAsync(SelectedProjectId.Value))
                .OrderBy(x => x.SortOrder)
                .ToList();
        }
    }

    private async Task ApplyBulkActionAsync()
    {
        if (!CanApplyBulkAction || isApplyingBulkAction)
        {
            return;
        }

        var issueIds = selectedIssueIds.ToList();

        try
        {
            isApplyingBulkAction = true;

            if (bulkActionKind == BulkActionKind.AssignAssignee)
            {
                Guid? assigneeId = bulkAssigneeValue == UnassignedAssigneeValue
                    ? null
                    : Guid.Parse(bulkAssigneeValue);

                foreach (var issueId in issueIds)
                {
                    var issue = await WorkTrackingService.GetIssueAsync(issueId);
                    if (issue is null)
                    {
                        continue;
                    }

                    await WorkTrackingService.UpdateIssueAsync(new UpdateIssueCommand(
                        issue.Id,
                        issue.Title,
                        issue.Description,
                        issue.Type,
                        issue.Priority,
                        assigneeId,
                        issue.DueDate,
                        issue.Labels.Select(x => x.Name).ToList()));
                }
            }
            else if (bulkStatusId.HasValue && currentUserId.HasValue)
            {
                foreach (var issueId in issueIds)
                {
                    await WorkTrackingService.MoveIssueAsync(new MoveIssueCommand(issueId, bulkStatusId.Value, currentUserId.Value));
                }
            }

            selectedIssueIds.Clear();
            showBulkActionsModal = false;
            await RefreshIssuesAsync();
        }
        finally
        {
            isApplyingBulkAction = false;
        }
    }

    private async Task<Guid?> ResolveCurrentUserIdAsync()
    {
        var authenticationState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var userIdClaim = authenticationState.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
        return Guid.TryParse(userIdClaim, out var userId) ? userId : null;
    }

    private static string GetStatusPillClass(IssueStatusCategory category) => category switch
    {
        IssueStatusCategory.ToDo => "status-pill-todo",
        IssueStatusCategory.InProgress => "status-pill-progress",
        IssueStatusCategory.Done => "status-pill-done",
        _ => "status-pill-default"
    };

    private static string GetPriorityPillClass(IssuePriority priority) => priority switch
    {
        IssuePriority.Low => "priority-pill-low",
        IssuePriority.Medium => "priority-pill-medium",
        IssuePriority.High => "priority-pill-high",
        _ => "priority-pill-default"
    };

    private static string GetDueDateText(DateOnly? dueDate)
    {
        return dueDate?.ToString("dd MMM yyyy") ?? "No due date";
    }

    private static string GetDuePillClass(DateOnly? dueDate)
    {
        if (!dueDate.HasValue)
        {
            return "due-pill-none";
        }

        var today = DateOnly.FromDateTime(DateTime.Today);
        if (dueDate.Value < today)
        {
            return "due-pill-overdue";
        }

        if (dueDate.Value == today)
        {
            return "due-pill-today";
        }

        return "due-pill-upcoming";
    }

    private sealed class IssueFilterState
    {
        public string? SearchText { get; set; }
        public Guid? ProjectId { get; set; }
        public Guid? AssigneeId { get; set; }
        public IssueStatusCategory? Category { get; set; }
        public IssuePriority? Priority { get; set; }
    }

    private enum BulkActionKind
    {
        AssignAssignee,
        MoveStatus
    }
}
