@page "/board"
@rendermode InteractiveServer
@inject IWorkTrackingService WorkTrackingService
@inject NavigationManager NavigationManager
@inject AuthenticationStateProvider AuthenticationStateProvider

<PageTitle>Board</PageTitle>

@if (projects.Count == 0)
{
    <p class="empty-state">Loading board...</p>
}
else
{
    <section class="panel-card">
        <div class="panel-header">
            <div>
                <p class="panel-kicker">Board</p>
                <h1>Kanban overview</h1>
            </div>
            <div class="board-toolbar">
                <label class="compact-field">
                    <span>Project</span>
                    <InputSelect @bind-Value="selectedProjectId" @bind-Value:after="LoadBoardAsync">
                        @foreach (var project in projects)
                        {
                            <option value="@project.Id">@project.Key - @project.Name</option>
                        }
                    </InputSelect>
                </label>
                <button type="button" class="action-button" @onclick="OpenCreateIssueModal">Create issue</button>
            </div>
        </div>
    </section>

    <section class="board-grid">
        @foreach (var column in columns)
        {
            <div class="board-column @(dropTargetStatusId == column.StatusId ? "board-column-active" : string.Empty)"
                 ondragover="event.preventDefault();"
                 @ondragenter="@(() => SetDropTarget(column.StatusId))"
                 @ondragleave="@(() => ClearDropTarget(column.StatusId))"
                 @ondragover:preventDefault="true"
                 @ondrop="@(() => HandleDropAsync(column.StatusId))">
                <div class="board-column-header">
                    <div>
                        <h2>@column.StatusName</h2>
                    </div>
                    <strong>@column.Issues.Count</strong>
                </div>
                @foreach (var issue in column.Issues)
                {
                    <div class="board-ticket @(draggingIssueId == issue.Id ? "board-ticket-dragging" : string.Empty)"
                         data-issue-id="@issue.Id"
                         draggable="true"
                         ondragstart="event.dataTransfer.setData('text/plain', this.dataset.issueId); event.dataTransfer.effectAllowed = 'move';"
                         @onmousedown="@(() => StartDrag(issue.Id, issue.StatusId))"
                         @ondragend="EndDrag">
                        <a href="/issues/@issue.Id">
                            <p>@issue.Title</p>
                        </a>
                        <div class="ticket-footer">
                            <span class="issue-key">@issue.Key</span>
                            <InitialismAvatar Name="@issue.AssigneeName" />
                        </div>
                    </div>
                }
            </div>
        }
    </section>
}

@if (showCreateIssueModal)
{
    <div class="modal-backdrop" @onclick="CloseCreateIssueModal">
        <section class="modal-panel panel-card" @onclick:stopPropagation="true">
            <div class="panel-header">
                <div>
                    <p class="panel-kicker">Board</p>
                    <h2>Create issue</h2>
                </div>
            </div>

            <EditForm Model="createIssueForm" OnValidSubmit="CreateIssueAsync">
                <div class="form-grid">
                    <label class="full-width">
                        <span>Title</span>
                        <InputText @bind-Value="createIssueForm.Title" />
                    </label>
                    <label class="full-width">
                        <span>Description</span>
                        <InputTextArea @bind-Value="createIssueForm.Description" />
                    </label>
                    <label>
                        <span>Type</span>
                        <InputSelect @bind-Value="createIssueForm.Type">
                            @foreach (var type in Enum.GetValues<IssueType>())
                            {
                                <option value="@type">@type</option>
                            }
                        </InputSelect>
                    </label>
                    <label>
                        <span>Priority</span>
                        <InputSelect @bind-Value="createIssueForm.Priority">
                            @foreach (var priority in Enum.GetValues<IssuePriority>())
                            {
                                <option value="@priority">@priority</option>
                            }
                        </InputSelect>
                    </label>
                    <label>
                        <span>Assignee</span>
                        <InputSelect @bind-Value="createIssueForm.AssigneeId">
                            <option value="">Unassigned</option>
                            @foreach (var user in users)
                            {
                                <option value="@user.Id">@user.DisplayName</option>
                            }
                        </InputSelect>
                    </label>
                    <label>
                        <span>Project</span>
                        <InputSelect @bind-Value="createIssueForm.ProjectId">
                            @foreach (var project in projects)
                            {
                                <option value="@project.Id">@project.Key - @project.Name</option>
                            }
                        </InputSelect>
                    </label>
                    <label class="full-width">
                        <span>Labels (comma separated)</span>
                        <InputText @bind-Value="createIssueForm.Labels" />
                    </label>
                </div>

                <div class="modal-actions">
                    <button type="submit" class="action-button" disabled="@isCreatingIssue">Create</button>
                    <button type="button" class="action-button action-button-secondary" @onclick="CloseCreateIssueModal">Cancel</button>
                </div>
            </EditForm>
        </section>
    </div>
}

@code {
    private List<ProjectReferenceDto> projects = [];
    private List<KanbanColumnDto> columns = [];
    private List<UserReferenceDto> users = [];
    private Guid selectedProjectId;
    private Guid? currentUserId;
    private Guid? draggingIssueId;
    private Guid? draggingFromStatusId;
    private Guid? dropTargetStatusId;
    private bool isMovingIssue;
    private bool isCreatingIssue;
    private bool showCreateIssueModal;
    private readonly CreateIssueForm createIssueForm = new();

    protected override async Task OnInitializedAsync()
    {
        currentUserId = await ResolveCurrentUserIdAsync();
        projects = (await WorkTrackingService.GetProjectsAsync()).ToList();
        users = (await WorkTrackingService.GetUsersAsync()).ToList();

        if (projects.Count == 0)
        {
            return;
        }

        var uri = NavigationManager.ToAbsoluteUri(NavigationManager.Uri);
        var projectIdQuery = Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(uri.Query).TryGetValue("projectId", out var rawProjectId)
            && Guid.TryParse(rawProjectId, out var parsedProjectId)
            ? parsedProjectId
            : projects[0].Id;

        selectedProjectId = projects.Any(x => x.Id == projectIdQuery) ? projectIdQuery : projects[0].Id;
        await LoadBoardAsync();
    }

    private async Task LoadBoardAsync()
    {
        if (selectedProjectId == Guid.Empty)
        {
            return;
        }

        columns = (await WorkTrackingService.GetBoardAsync(selectedProjectId)).ToList();
    }

    private void OpenCreateIssueModal()
    {
        createIssueForm.ProjectId = selectedProjectId;
        showCreateIssueModal = true;
    }

    private void CloseCreateIssueModal()
    {
        showCreateIssueModal = false;
    }

    private async Task CreateIssueAsync()
    {
        if (!currentUserId.HasValue || createIssueForm.ProjectId == Guid.Empty || string.IsNullOrWhiteSpace(createIssueForm.Title) || isCreatingIssue)
        {
            return;
        }

        try
        {
            isCreatingIssue = true;
            await WorkTrackingService.CreateIssueAsync(new CreateIssueCommand(
                createIssueForm.ProjectId,
                createIssueForm.Title,
                createIssueForm.Description ?? string.Empty,
                createIssueForm.Type,
                createIssueForm.Priority,
                currentUserId.Value,
                createIssueForm.AssigneeId,
                SplitLabels(createIssueForm.Labels)));

            createIssueForm.Title = string.Empty;
            createIssueForm.Description = string.Empty;
            createIssueForm.Labels = string.Empty;
            createIssueForm.AssigneeId = null;
            createIssueForm.Type = IssueType.Task;
            createIssueForm.Priority = IssuePriority.Medium;
            showCreateIssueModal = false;
            selectedProjectId = createIssueForm.ProjectId;
            await LoadBoardAsync();
        }
        finally
        {
            isCreatingIssue = false;
        }
    }

    private async Task MoveIssueAsync(Guid issueId, Guid statusId)
    {
        if (!currentUserId.HasValue || isMovingIssue)
        {
            return;
        }

        try
        {
            isMovingIssue = true;
            await WorkTrackingService.MoveIssueAsync(new MoveIssueCommand(issueId, statusId, currentUserId.Value));
            await LoadBoardAsync();
        }
        finally
        {
            isMovingIssue = false;
        }
    }

    private void StartDrag(Guid issueId, Guid statusId)
    {
        draggingIssueId = issueId;
        draggingFromStatusId = statusId;
        dropTargetStatusId = statusId;
    }

    private void EndDrag()
    {
        draggingIssueId = null;
        draggingFromStatusId = null;
        dropTargetStatusId = null;
    }

    private void SetDropTarget(Guid statusId)
    {
        if (draggingIssueId.HasValue)
        {
            dropTargetStatusId = statusId;
        }
    }

    private void ClearDropTarget(Guid statusId)
    {
        if (dropTargetStatusId == statusId && draggingFromStatusId != statusId)
        {
            dropTargetStatusId = null;
        }
    }

    private async Task HandleDropAsync(Guid statusId)
    {
        if (!draggingIssueId.HasValue)
        {
            return;
        }

        var issueId = draggingIssueId.Value;
        var currentStatusId = draggingFromStatusId;
        EndDrag();

        if (currentStatusId == statusId)
        {
            return;
        }

        await MoveIssueAsync(issueId, statusId);
    }

    private async Task<Guid?> ResolveCurrentUserIdAsync()
    {
        var authenticationState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var userIdClaim = authenticationState.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
        return Guid.TryParse(userIdClaim, out var userId) ? userId : null;
    }

    private static IReadOnlyList<string> SplitLabels(string? labels)
    {
        return string.IsNullOrWhiteSpace(labels)
            ? []
            : labels.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
    }

    private sealed class CreateIssueForm
    {
        public Guid ProjectId { get; set; }
        public string Title { get; set; } = string.Empty;
        public string? Description { get; set; }
        public IssueType Type { get; set; } = IssueType.Task;
        public IssuePriority Priority { get; set; } = IssuePriority.Medium;
        public Guid? AssigneeId { get; set; }
        public string? Labels { get; set; }
    }
}
