<span class="@CssClass"
      title="@Tooltip"
      aria-label="@Tooltip">
    @Initials
</span>

@code {
    [Parameter] public string? Name { get; set; }
    [Parameter] public string? Class { get; set; }

    private string Tooltip => string.IsNullOrWhiteSpace(Name) ? "Unassigned" : Name;
    private string CssClass => string.IsNullOrWhiteSpace(Class) ? "initialism-avatar" : $"initialism-avatar {Class}";

    private string Initials
    {
        get
        {
            if (string.IsNullOrWhiteSpace(Name))
            {
                return "UA";
            }

            var parts = Name
                .Split(' ', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
                .Take(2)
                .ToArray();

            return parts.Length switch
            {
                0 => "UA",
                1 => new string(parts[0].Take(2).ToArray()).ToUpperInvariant(),
                _ => string.Concat(parts.Select(x => char.ToUpperInvariant(x[0])))
            };
        }
    }
}
