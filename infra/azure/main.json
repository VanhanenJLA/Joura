{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "_generator": {
      "name": "bicep",
      "version": "0.41.2.15936",
      "templateHash": "17431214881819512775"
    }
  },
  "parameters": {
    "location": {
      "type": "string",
      "defaultValue": "[resourceGroup().location]",
      "metadata": {
        "description": "Deployment location."
      }
    },
    "env": {
      "type": "string",
      "defaultValue": "demo",
      "allowedValues": [
        "demo",
        "prod"
      ],
      "metadata": {
        "description": "Deployment environment."
      }
    },
    "projectName": {
      "type": "string",
      "defaultValue": "joura",
      "minLength": 3,
      "maxLength": 12,
      "metadata": {
        "description": "Project name used in resource naming."
      }
    },
    "suffixLength": {
      "type": "int",
      "defaultValue": 5,
      "minValue": 4,
      "maxValue": 8,
      "metadata": {
        "description": "Short unique suffix length for globally unique resource names."
      }
    },
    "appServiceSkuName": {
      "type": "string",
      "defaultValue": "F1",
      "allowedValues": [
        "F1",
        "B1"
      ],
      "metadata": {
        "description": "App Service SKU. F1 is the free tier and best suited only for demo/dev usage."
      }
    },
    "sqlAdministratorLogin": {
      "type": "string",
      "minLength": 1,
      "metadata": {
        "description": "SQL administrator login."
      }
    },
    "sqlAdministratorPassword": {
      "type": "securestring",
      "metadata": {
        "description": "SQL administrator password."
      }
    },
    "allowedClientIp": {
      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "Optional client IPv4 address allowed through the SQL firewall, for example 203.0.113.10. Leave blank to skip."
      }
    },
    "extraTags": {
      "type": "object",
      "defaultValue": {},
      "metadata": {
        "description": "Additional tag values applied to all resources."
      }
    }
  },
  "variables": {
    "unique": "[uniqueString(subscription().id, resourceGroup().id, parameters('projectName'), parameters('env'))]",
    "suffix": "[toLower(take(variables('unique'), parameters('suffixLength')))]",
    "tags": "[union(createObject('app', 'Joura', 'environment', parameters('env'), 'managedBy', 'bicep', 'project', parameters('projectName')), parameters('extraTags'))]",
    "nameAppServicePlan": "[format('asp-{0}-{1}', parameters('projectName'), parameters('env'))]",
    "nameWebApp": "[format('app-{0}-{1}-{2}', parameters('projectName'), parameters('env'), variables('suffix'))]",
    "nameSqlServer": "[format('sql-{0}-{1}-{2}', parameters('projectName'), parameters('env'), variables('suffix'))]",
    "nameSqlDatabase": "[format('sqldb-{0}-{1}', parameters('projectName'), parameters('env'))]",
    "isFreePlan": "[equals(parameters('appServiceSkuName'), 'F1')]",
    "sqlConnectionString": "[format('Server=tcp:{0}.{1},1433;Initial Catalog={2};Persist Security Info=False;User ID={3};Password={4};MultipleActiveResultSets=False;Encrypt=True;TrustServerCertificate=False;Connection Timeout=30;', variables('nameSqlServer'), environment().suffixes.sqlServerHostname, variables('nameSqlDatabase'), parameters('sqlAdministratorLogin'), parameters('sqlAdministratorPassword'))]"
  },
  "resources": [
    {
      "type": "Microsoft.Web/serverfarms",
      "apiVersion": "2023-01-01",
      "name": "[variables('nameAppServicePlan')]",
      "location": "[parameters('location')]",
      "kind": "windows",
      "sku": {
        "name": "[parameters('appServiceSkuName')]"
      },
      "tags": "[variables('tags')]"
    },
    {
      "type": "Microsoft.Web/sites",
      "apiVersion": "2023-01-01",
      "name": "[variables('nameWebApp')]",
      "location": "[parameters('location')]",
      "identity": {
        "type": "SystemAssigned"
      },
      "tags": "[variables('tags')]",
      "properties": {
        "serverFarmId": "[resourceId('Microsoft.Web/serverfarms', variables('nameAppServicePlan'))]",
        "httpsOnly": true,
        "siteConfig": {
          "minTlsVersion": "1.2",
          "ftpsState": "Disabled",
          "use32BitWorkerProcess": true,
          "alwaysOn": "[not(variables('isFreePlan'))]",
          "appSettings": [
            {
              "name": "ASPNETCORE_ENVIRONMENT",
              "value": "Production"
            },
            {
              "name": "DatabaseProvider",
              "value": "SqlServer"
            },
            {
              "name": "ConnectionStrings__SqlServer",
              "value": "[variables('sqlConnectionString')]"
            }
          ]
        }
      },
      "dependsOn": [
        "[resourceId('Microsoft.Web/serverfarms', variables('nameAppServicePlan'))]",
        "[resourceId('Microsoft.Sql/servers/databases', variables('nameSqlServer'), variables('nameSqlDatabase'))]",
        "[resourceId('Microsoft.Sql/servers', variables('nameSqlServer'))]"
      ]
    },
    {
      "type": "Microsoft.Sql/servers",
      "apiVersion": "2023-08-01",
      "name": "[variables('nameSqlServer')]",
      "location": "[parameters('location')]",
      "tags": "[variables('tags')]",
      "properties": {
        "administratorLogin": "[parameters('sqlAdministratorLogin')]",
        "administratorLoginPassword": "[parameters('sqlAdministratorPassword')]",
        "publicNetworkAccess": "Enabled",
        "minimalTlsVersion": "1.2",
        "version": "12.0"
      }
    },
    {
      "type": "Microsoft.Sql/servers/databases",
      "apiVersion": "2023-08-01",
      "name": "[format('{0}/{1}', variables('nameSqlServer'), variables('nameSqlDatabase'))]",
      "location": "[parameters('location')]",
      "tags": "[variables('tags')]",
      "sku": {
        "name": "GP_S_Gen5_1",
        "tier": "GeneralPurpose",
        "family": "Gen5",
        "capacity": 1
      },
      "properties": {
        "autoPauseDelay": 60,
        "collation": "SQL_Latin1_General_CP1_CI_AS",
        "createMode": "Default",
        "freeLimitExhaustionBehavior": "AutoPause",
        "maxSizeBytes": 34359738368,
        "readScale": "Disabled",
        "requestedBackupStorageRedundancy": "Local",
        "useFreeLimit": true,
        "zoneRedundant": false
      },
      "dependsOn": [
        "[resourceId('Microsoft.Sql/servers', variables('nameSqlServer'))]"
      ]
    },
    {
      "type": "Microsoft.Sql/servers/firewallRules",
      "apiVersion": "2023-08-01",
      "name": "[format('{0}/{1}', variables('nameSqlServer'), 'AllowAzureServices')]",
      "properties": {
        "startIpAddress": "0.0.0.0",
        "endIpAddress": "0.0.0.0"
      },
      "dependsOn": [
        "[resourceId('Microsoft.Sql/servers', variables('nameSqlServer'))]"
      ]
    },
    {
      "condition": "[not(empty(parameters('allowedClientIp')))]",
      "type": "Microsoft.Sql/servers/firewallRules",
      "apiVersion": "2023-08-01",
      "name": "[format('{0}/{1}', variables('nameSqlServer'), 'AllowNamedClientIp')]",
      "properties": {
        "startIpAddress": "[parameters('allowedClientIp')]",
        "endIpAddress": "[parameters('allowedClientIp')]"
      },
      "dependsOn": [
        "[resourceId('Microsoft.Sql/servers', variables('nameSqlServer'))]"
      ]
    }
  ],
  "outputs": {
    "appServicePlanName": {
      "type": "string",
      "value": "[variables('nameAppServicePlan')]"
    },
    "webAppName": {
      "type": "string",
      "value": "[variables('nameWebApp')]"
    },
    "webAppUrl": {
      "type": "string",
      "value": "[format('https://{0}', reference(resourceId('Microsoft.Web/sites', variables('nameWebApp')), '2023-01-01').defaultHostName)]"
    },
    "sqlServerFullyQualifiedDomainName": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.Sql/servers', variables('nameSqlServer')), '2023-08-01').fullyQualifiedDomainName]"
    },
    "sqlDatabaseName": {
      "type": "string",
      "value": "[variables('nameSqlDatabase')]"
    }
  }
}